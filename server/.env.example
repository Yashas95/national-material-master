# ==============================================================================
# National Unified Material Master Framework (NUMMF) - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Network Settings
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Persistence: PostgreSQL with pgvector
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://nummf_user:nummf_pass@localhost:5432/nummf_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# Queue & Cache: Redis for BullMQ Ingestion/Clustering Tasks
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Secrets (At least 16 characters)
# NOTE: Replace with cryptographically secure random keys in production
# ------------------------------------------------------------------------------
JWT_SECRET=nummf_dev_secret_key_at_least_16_chars_long
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=nummf_dev_refresh_secret_key_at_least_16_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Google Gen AI SDK)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# Platform & Enterprise Feature Flags
# ------------------------------------------------------------------------------
# Enables tenant-level masking for CPSE_ADMIN role
ENABLE_TENANT_ISOLATION=true
# Auto-triggers clustering pipeline on new batch ingestions
ENABLE_AUTO_MATCHING=true
# Max multipart file upload payload size in Megabytes
MAX_FILE_UPLOAD_MB=25
